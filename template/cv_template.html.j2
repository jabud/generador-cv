<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<style>
@font-face {
  font-family: 'Inter';
  src: url('{{ fonts_dir }}/Inter-Regular.ttf');
  font-weight: 400;
}
@font-face {
  font-family: 'Inter';
  src: url('{{ fonts_dir }}/Inter-SemiBold.ttf');
  font-weight: 600;
}
@font-face {
  font-family: 'Inter';
  src: url('{{ fonts_dir }}/Inter-Bold.ttf');
  font-weight: 700;
}

@page {
  size: letter;
  margin: 0.72in 0.85in 0.75in 0.85in;
  @bottom-left {
    content: "{{ cv.name }}";
    font-family: 'Inter';
    font-size: 8.5px;
    color: #9a9a9a;
  }
  @bottom-right {
    content: counter(page);
    font-family: 'Inter';
    font-size: 8.5px;
    color: #9a9a9a;
  }
}

* { box-sizing: border-box; }

body {
  font-family: 'Inter', sans-serif;
  font-size: 10.3px;
  line-height: 1.5;
  color: #1c1c1c;
  margin: 0;
  padding: 0;
}

a { color: #1c1c1c; text-decoration: underline; }

.name { font-size: 24px; font-weight: 700; margin: 0 0 3px 0; letter-spacing: -0.3px; }
.headline { font-size: 11.5px; font-weight: 600; color: #333; margin: 0 0 12px 0; }
.contact-grid { display: flex; justify-content: space-between; margin-bottom: 6px; font-size: 9.8px; }
.contact-col { width: 48%; }
.contact-row { margin-bottom: 3px; }
.contact-label { font-weight: 600; }

h2 {
  font-size: 12.5px;
  font-weight: 700;
  margin: 14px 0 5px 0;
  padding-bottom: 3px;
  border-bottom: 1px solid #d9d9d9;
}
.section:first-of-type h2 { margin-top: 12px; }

.about-lead { margin: 0 0 6px 0; }
.about ul { margin: 0 0 8px 0; padding-left: 16px; }
.about li { margin-bottom: 3px; }
.about-closing { margin: 8px 0 0 0; }

.entry { margin-bottom: 10px; page-break-inside: avoid; }
.entry:last-child { margin-bottom: 0; }

.company-name { font-size: 11.5px; font-weight: 700; margin-bottom: 7px; }

.roles { position: relative; margin-left: 3px; padding-left: 16px; }
.role { position: relative; padding-bottom: 9px; page-break-inside: avoid; }
.role:last-child { padding-bottom: 0; }
.role::before {
  content: '';
  position: absolute;
  left: -20.5px;
  top: 3px;
  width: 7px;
  height: 7px;
  border-radius: 50%;
  background: #8a8a8a;
  z-index: 1;
}
.role:not(:last-child)::after {
  content: '';
  position: absolute;
  left: -17.7px;
  top: 10px;
  bottom: 0;
  width: 1.6px;
  background: #dcdcdc;
}

.role-title { font-weight: 700; font-size: 10.6px; }
.role-dates { color: #767676; font-size: 9.5px; }
.role-header { margin-bottom: 3px; }

ul.bullets { margin: 0; padding-left: 15px; }
ul.bullets li { margin-bottom: 3px; }
ul.bullets li:last-child { margin-bottom: 0; }

.edu-item { margin-bottom: 6px; }
.edu-item:last-child { margin-bottom: 0; }
.edu-title { font-weight: 700; }
.edu-sub { color: #444; }

.project { margin-bottom: 7px; }
.project:last-child { margin-bottom: 0; }
.project-title { font-weight: 700; }

.skills-grid { display: flex; justify-content: space-between; gap: 20px; }
.skills-col { flex: 1; }
.skills-cat { font-weight: 700; font-size: 10.3px; margin-bottom: 5px; }
.skills-col ul { margin: 0; padding-left: 15px; }
.skills-col li { margin-bottom: 3px; }

.languages { margin: 0; }
</style>
</head>
<body>

<div class="name">{{ cv.name }}</div>
<div class="headline">{{ cv.headline }}</div>

<div class="contact-grid">
  <div class="contact-col">
    <div class="contact-row"><span class="contact-label">Email:</span> {{ cv.contact.email }}</div>
    <div class="contact-row"><span class="contact-label">Telegram:</span> <a href="{{ cv.contact.telegram.url }}">{{ cv.contact.telegram.label }}</a></div>
  </div>
  <div class="contact-col">
    <div class="contact-row"><span class="contact-label">Linkedin:</span> <a href="{{ cv.contact.linkedin.url }}">{{ cv.contact.linkedin.label }}</a></div>
    <div class="contact-row"><span class="contact-label">Website:</span> <a href="{{ cv.contact.website.url }}">{{ cv.contact.website.label }}</a></div>
  </div>
</div>

<div class="section">
<h2>About</h2>
<p class="about-lead">{{ cv.about.lead }}</p>
<ul>
  {% for item in cv.about.bullets %}
  <li>{{ item }}</li>
  {% endfor %}
</ul>
<p class="about-closing">{{ cv.about.closing }}</p>
</div>

<div class="section">
<h2>Experience</h2>
{% for company in cv.experience %}
<div class="entry">
  <div class="company-name">
    {% if company.url %}<a href="{{ company.url }}">{{ company.company }}</a>{% else %}<span style="text-decoration: underline;">{{ company.company }}</span>{% endif %}
  </div>
  <div class="roles">
    {% for role in company.roles %}
    <div class="role">
      <div class="role-header"><span class="role-title">{{ role.title }}</span> <span class="role-dates">({{ role.dates }})</span></div>
      <ul class="bullets">
        {% for bullet in role.bullets %}
        <li>{{ bullet | safe }}</li>
        {% endfor %}
      </ul>
    </div>
    {% endfor %}
  </div>
</div>
{% endfor %}
</div>

<div class="section">
<h2>Education</h2>
{% for edu in cv.education %}
<div class="edu-item">
  <div class="edu-title">
    {% if edu.url %}<a href="{{ edu.url }}">{{ edu.title }}</a>{% else %}{{ edu.title }}{% endif %}
  </div>
  <div class="edu-sub">{{ edu.subtitle }}</div>
</div>
{% endfor %}
</div>

<div class="section">
<h2>Projects</h2>
{% for project in cv.projects %}
<div class="project">
  <div class="project-title">{{ project.title }}</div>
  <div>{{ project.body | safe }}</div>
</div>
{% endfor %}
</div>

<div class="section">
<h2>Skills</h2>
<div class="skills-grid">
  {% for group in cv.skills %}
  <div class="skills-col">
    <div class="skills-cat">{{ group.category }}</div>
    <ul>
      {% for item in group['items'] %}
      <li>{{ item }}</li>
      {% endfor %}
    </ul>
  </div>
  {% endfor %}
</div>
</div>

<div class="section" style="page-break-before: avoid;">
<h2>Languages</h2>
<p class="languages">{{ cv.languages }}</p>
</div>

</body>
</html>
